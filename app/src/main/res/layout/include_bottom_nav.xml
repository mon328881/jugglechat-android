<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <!-- 分隔线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorSurfaceVariant" />

    <!-- 导航栏容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="?attr/colorSurface">

        <!-- 聊天标签 -->
        <FrameLayout
            android:id="@+id/tab_chats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <!-- 未读徽章 -->
            <TextView
                android:id="@+id/unread_dot"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:gravity="center"
                android:text="99"
                android:visibility="gone"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnError"
                android:background="@drawable/badge_background" />

            <!-- 标签内容 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/tab_chats_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/tab_chat"
                    android:contentDescription="@string/tab_chat"
                    android:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tab_chats_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tab_chat"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

        <!-- 联系人标签 -->
        <LinearLayout
            android:id="@+id/tab_contacts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/tab_contacts_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_contact"
                android:contentDescription="@string/tab_contact"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_contacts_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_contact"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 发现标签 -->
        <LinearLayout
            android:id="@+id/tab_discover"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/tab_discover_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_friend"
                android:contentDescription="@string/tab_friend"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_discover_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_friend"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 我的标签 -->
        <LinearLayout
            android:id="@+id/tab_me"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:foreground="?attr/selectableItemBackground">

            <ImageView
                android:id="@+id/tab_me_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/tab_me"
                android:contentDescription="@string/tab_me"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tab_me_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/tab_me"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
