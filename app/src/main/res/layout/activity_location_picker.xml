<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 地图全屏 -->
    <com.tencent.tencentmap.mapsdk.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 地图中心绿色指针（固定在可视范围中心） -->
    <ImageView
        android:id="@+id/map_center_pin"
        android:layout_width="32dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_location_pin_green"
        android:contentDescription="@null"
        android:scaleType="centerInside" />

    <!-- 顶部操作栏悬浮：取消 | 发送（绿色），半透明背景可见地图 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_gravity="top"
        android:background="#33000000"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/txt_cancel"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_send_location"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:minWidth="80dp"
            android:background="@drawable/bg_location_send_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="@string/location_send_btn"
            android:textColor="@color/white"
            android:textSize="15sp" />
    </FrameLayout>

    <!-- 地图左下角：定位到我的位置按钮（悬浮在底栏上方） -->
    <ImageButton
        android:id="@+id/btn_relocate"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="276dp"
        android:background="@drawable/bg_location_my_location_btn"
        android:contentDescription="@string/location_btn_relocate"
        android:src="@drawable/ic_my_location_target"
        android:scaleType="centerInside"
        android:padding="10dp" />

    <!-- 底部：搜索栏 + 地点列表（白底） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_location_search_bar">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:src="@drawable/ic_location_search"
                android:contentDescription="@string/cd_search"
                android:scaleType="centerInside" />

            <EditText
                android:id="@+id/edt_search_place"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="44dp"
                android:layout_marginEnd="12dp"
                android:background="@null"
                android:hint="@string/location_search_placeholder"
                android:textColor="@color/title"
                android:textColorHint="#999999"
                android:textSize="15sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:maxLines="1" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_location_list"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            tools:listitem="@layout/item_location_picker" />
    </LinearLayout>
</FrameLayout>
