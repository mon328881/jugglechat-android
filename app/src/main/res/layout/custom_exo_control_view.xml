<?xml version="1.0" encoding="utf-8"?>
<!-- 自定义 ExoPlayer 控制条：底部留白、进度条明显可拖动。ID 与库内 StyledPlayerControlView 一致。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom">

    <!-- 中央播放/暂停（库会控制显示） -->
    <FrameLayout
        android:id="@+id/exo_center_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <ImageButton
            android:id="@+id/exo_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="播放/暂停"
            android:padding="12dp"
            android:src="@drawable/ic_play"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <!-- 底部条：留白 + 进度条 + 时间 -->
    <LinearLayout
        android:id="@+id/exo_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:background="#DD000000">

        <!-- 进度条：加高、加大触摸区域，便于拖动 -->
        <com.google.android.exoplayer2.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:bar_height="6dp"
            app:touch_target_height="40dp"
            app:played_color="#FF2196F3"
            app:buffered_color="#662196F3"
            app:unplayed_color="#33FFFFFF"
            app:scrubber_color="#FFFFFFFF"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/exo_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:text="0:00" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/exo_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="48dp"
                android:gravity="end"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:text="0:00" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
