<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Avatar -->
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/default_avatar"
        android:contentDescription="@string/cd_avatar" />

    <!-- User Info Container -->
    <LinearLayout
        android:id="@+id/ll_user_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/iv_avatar"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_toStartOf="@id/tv_status"
        android:orientation="vertical">

        <!-- Nickname -->
        <TextView
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Description -->
        <TextView
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Status Text -->
    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp" />

    <!-- Action Buttons Container (default gone) -->
    <LinearLayout
        android:id="@+id/ll_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:visibility="gone">

        <!-- Reject Button -->
        <android.widget.Button
            android:id="@+id/btn_reject"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:background="@drawable/btn_friend_action_outline"
            android:text="@string/friend_app_btn_reject"
            android:textColor="@color/primary_bg_light"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />

        <!-- Accept Button -->
        <android.widget.Button
            android:id="@+id/btn_accept"
            android:layout_width="70dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_button"
            android:text="@string/friend_app_btn_accept"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:minWidth="0dp"
            android:paddingLeft="8dp"
            android:paddingRight="8dp" />
    </LinearLayout>

</RelativeLayout>
