<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 极光推送自定义权限（包名需与 applicationId 一致） -->
    <permission
        android:name="com.juggle.im.android.permission.JPUSH_MESSAGE"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.juggle.im.android.permission.JPUSH_MESSAGE" />   
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission
        android:name="android.permission.VIBRATE"
        android:maxSdkVersion="18" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Camera (used by camera plugin) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Microphone for voice recording -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Read gallery images: for older devices and Android 13+ -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" /> <!-- only needed up to Android 9 for legacy writes -->

    <!-- For Android 13+ prefer this to access images in media provider -->
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:ignore="PhotoAndVideoPolicy" />

    <!-- 腾讯地图 SDK 需要的网络、定位与存储权限 -->
    <!-- 访问网络获取地图服务 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 检查网络可用性 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 访问 WiFi 状态 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 使用手机当前位置（仅前台使用，用于默认定位到当前点） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 数据同步前台服务类型 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    
    <!-- 网络监听权限 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <application
        android:name="com.juggle.im.android.Application"

        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <!-- 腾讯地图 SDK Key（请替换为你在腾讯位置服务控制台申请的 Key） -->
        <meta-data
            android:name="TencentMapSDK"
            android:value="QQXBZ-IWGKW-XHBR7-YWZBH-LEDKV-VQBYK" />
        <!-- FileProvider: use applicationId substitution so authority matches runtime packageName -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:label="File Provider">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".app.FlashActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan|stateHidden">

        </activity>

        <activity
            android:name=".app.AddFriendActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".app.FriendApplicationsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.juggle.im.android.app.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait"/>

        <activity android:name="com.juggle.im.android.app.RegisterActivity"
            android:screenOrientation="portrait" />

        <activity
            android:name=".chat.ConversationActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".chat.MomentsActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity android:name=".chat.ConversationSettingsActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.GroupManagementActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".app.CreateGroupActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.MergeMessageActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".chat.ForwardConversationListActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.ImagePreviewActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.CreatePostActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.AlbumActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.EditNicknameActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".chat.call.SingleCallActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.call.MultiCallActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.SelectMemberActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".chat.LocationPickerActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".chat.LocationPreviewActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".chat.FavoritesPickerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity android:name=".chat.SearchActivity"
            android:screenOrientation="portrait"/>
        <activity android:name=".app.QRShareActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.PermissionManageActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".app.PrivacyPolicyActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.GroupListActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.GroupAdminsActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.TransferOwnerActivity"
            android:screenOrientation="portrait" />
        <activity android:name=".chat.VideoPlayerActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity android:name=".chat.MomentDetailActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity android:name=".chat.ScanActivity"
            android:screenOrientation="portrait"
            android:exported="false" />

        <!-- IM前台服务：保持长连接，防止文件选择时被系统回收 -->
        <service
            android:name=".service.ImForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 极光推送：自定义消息接收器 -->
        <receiver
            android:name=".MyJPushMessageReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.RECEIVE_MESSAGE" />
                <category android:name="${applicationId}" />
            </intent-filter>
        </receiver>

        <!-- 极光推送：通用 Service -->
        <service
            android:name=".MyJCommonService"
            android:exported="false"
            android:permission="cn.jpush.android.permission.JPUSH_MESSAGE">
            <intent-filter>
                <action android:name="cn.jpush.android.intent.JCOMMON_SERVICE" />
            </intent-filter>
        </service>
    </application>

</manifest>